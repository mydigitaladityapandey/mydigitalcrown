{
  "buildCommand": "node --max-old-space-size=4096 ./node_modules/.bin/next build --webpack",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "functions": {
    "app/api/send-enquiry/route.ts": {
      "maxDuration": 10
    }
  },
  "build": {
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1",
      "NODE_ENV": "production"
    }
  }
}